.venv/
__pycache__/
.pytest_cache/
*.py[cod]
.DS_Store

# Keep directory placeholders but ignore generated data runs.
data/source-test-results/*.json
!data/source-test-results/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Local source-probing output should never be committed.
prosple_headers.txt
prosple_jobs.xml

# Generated canonical datasets and quality reports.
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts and ML-generated reports (rebuilt by
# scripts/train_role_classifier.py from whatever jobs.parquet currently is;
# committing them would go stale immediately).
data/models/*
!data/models/.gitkeep
data/analysis/ml-role-classifier-report.json
data/analysis/ml-role-suggestions.csv
