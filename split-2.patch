diff --git a/tests/test_skills_build.py b/tests/test_skills_build.py
index 1234567..7654321 100644
--- a/tests/test_skills_build.py
+++ b/tests/test_skills_build.py
@@ -40,10 +40,38 @@ def test_build_writes_skills_outputs(tmp_path: Path):
     assert report["target_market_job_count"] == 1
     assert report["unique_skill_count"] >= 4
     for filename in (
         "job_skills.parquet",
         "job_requirements.parquet",
         "skills_summary.parquet",
         "company_skills.parquet",
+        "capability_summary.parquet",
+        "technology_category_summary.parquet",
+        "company_capabilities.parquet",
         "skills-quality-report.json",
     ):
         assert (output_dir / filename).exists()
+
+    job_skill_rows = pq.read_table(
+        output_dir / "job_skills.parquet"
+    ).to_pylist()
+    python_row = next(
+        row for row in job_skill_rows if row["skill"] == "Python"
+    )
+
+    assert python_row["technology"] == "Python"
+    assert python_row["technology_category"] == "language"
+    assert python_row["capability"] == "Programming"
+
+    summary_rows = pq.read_table(
+        output_dir / "skills_summary.parquet"
+    ).to_pylist()
+    sql_row = next(row for row in summary_rows if row["skill"] == "SQL")
+
+    assert sql_row["technology"] == "SQL"
+    assert sql_row["technology_category"] == "query_language"
+    assert sql_row["capability"] == "Data Storage"
+
+    capability_rows = pq.read_table(
+        output_dir / "capability_summary.parquet"
+    ).to_pylist()
+    capabilities = {row["capability"] for row in capability_rows}
+
+    assert "Programming" in capabilities
+    assert "Cloud" in capabilities
diff --git a/docs/milestone-4-skills-extraction.md b/docs/milestone-4-skills-extraction.md
index 1111111..2222222 100644
--- a/docs/milestone-4-skills-extraction.md
+++ b/docs/milestone-4-skills-extraction.md
@@ -9,10 +9,13 @@ Outputs:
 data/processed/
 ├── job_skills.parquet
 ├── job_requirements.parquet
 ├── skills_summary.parquet
 ├── company_skills.parquet
+├── capability_summary.parquet
+├── technology_category_summary.parquet
+├── company_capabilities.parquet
 └── skills-quality-report.json
 ```

 A skill is counted once per vacancy, even when mentioned repeatedly. Every
 job-skill row retains the exact text evidence that triggered the match.
+
+The legacy `skill` and `category` columns remain available. New outputs add
+`technology`, `technology_category` and `capability`, allowing dashboards to
+separate concrete tools from broader domains and work capabilities.
